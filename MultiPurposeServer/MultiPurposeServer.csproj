<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
	<TargetFramework>net10.0</TargetFramework>
	<Nullable>enable</Nullable>
	<ImplicitUsings>enable</ImplicitUsings>
	<GenerateDocumentationFile>true</GenerateDocumentationFile>
	<AssemblyName>MultiPurposeServer</AssemblyName>
	<RootNamespace>MultiPurposeServer</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
	<PackageReference Include="Swashbuckle.AspNetCore" Version="6.5.0" />
  </ItemGroup>

  <ItemGroup>
	<PackageReference Include="Serilog.AspNetCore" Version="7.0.0" />
	<PackageReference Include="Serilog.Sinks.File" Version="5.0.0" />
  </ItemGroup>

  <ItemGroup>
	<PackageReference Include="Google.Apis.Auth" Version="1.75.0" />
	<PackageReference Include="System.IdentityModel.Tokens.Jwt" Version="6.37.0" />
  </ItemGroup>

  <ItemGroup>
    <Folder Include="Secrets\SampleApp.Mobile\" />
  </ItemGroup>

	<!-- Using SDK implicit compile items; explicit <Compile> entries removed to avoid duplicates -->

</Project>

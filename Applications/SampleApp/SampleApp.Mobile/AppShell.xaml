<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="SampleApp.Mobile.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:local="clr-namespace:SampleApp.Mobile"
    xmlns:pages="clr-namespace:SampleApp.Mobile.Pages"
    Title="SampleApp.Mobile">

    <!-- Login is the initial page -->
    <ShellContent Title="Login">
        <ShellContent.ContentTemplate>
            <DataTemplate>
                <pages:LoginPage />
            </DataTemplate>
        </ShellContent.ContentTemplate>
    </ShellContent>

    <!-- Home / MainPage route -->
    <ShellContent
        Title="Home"
        ContentTemplate="{DataTemplate local:MainPage}"
        Route="MainPage" />

</Shell>

<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="SampleApp.Mobile.Pages.LoginPage"
             Title="Login">

  <ScrollView>
    <VerticalStackLayout Padding="24" Spacing="16">
      <Label Text="SampleApp" FontSize="32" HorizontalOptions="Center" />

      <Entry x:Name="UsernameEntry" Placeholder="Username" />
      <Entry x:Name="PasswordEntry" Placeholder="Password" IsPassword="True" />

      <Button x:Name="LoginButton" Text="Login" Clicked="OnLoginClicked" />
      <Button x:Name="GoogleLoginButton" Text="Login with Google" Clicked="OnGoogleLoginClicked" />

      <ActivityIndicator x:Name="BusyIndicator" IsVisible="False" IsRunning="False" />

      <Label x:Name="MessageLabel" TextColor="Red" IsVisible="False" />
    </VerticalStackLayout>
  </ScrollView>

</ContentPage>

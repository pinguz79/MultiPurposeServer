<?xml version="1.0" encoding="utf-8"?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui" xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml" xmlns:local="clr-namespace:Finance.Mobile"
    x:Class="Finance.Mobile.MainPage" Title="Finance">
    <Grid RowDefinitions="Auto,Auto,Auto,*" Padding="16" RowSpacing="12">
        <HorizontalStackLayout Spacing="12">
            <Button x:Name="SettingsButton" Text="Connessione" Clicked="Configure" />
            <Button x:Name="RefreshButton" Text="Aggiorna" Clicked="Refresh" />
        </HorizontalStackLayout>
        <Label Grid.Row="1" x:Name="StatusLabel" Text="Configura la connessione al server." />
        <ActivityIndicator Grid.Row="2" x:Name="BusyIndicator" IsVisible="False" />
        <CollectionView Grid.Row="3" x:Name="Accounts" SelectionMode="None">
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="local:AccountCard">
                    <Border Padding="16" Margin="0,0,0,12" Stroke="#9AABB5">
                        <VerticalStackLayout Spacing="8">
                            <Label Text="{Binding Name}" FontSize="22" FontAttributes="Bold" />
                            <Label Text="{Binding Balance}" TextColor="{Binding BalanceColor}" FontSize="18" FontAttributes="Bold" />
                            <Label Text="{Binding Previous}" FontSize="13" />
                            <Label Text="{Binding Details}" />
                            <Label Text="{Binding Warning}" TextColor="{Binding WarningColor}" />
                        </VerticalStackLayout>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
    </Grid>
</ContentPage>
